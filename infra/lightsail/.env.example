Email__VerificationInbox=

Spotify__ClientId=
Spotify__ClientSecret=
Spotify__Market=BR

Auth__Google__ClientId=
Auth__Facebook__AppId=
Auth__Facebook__AppSecret=

App__TimeZone=America/Sao_Paulo
Logging__ApplicationLog__Format=Text
