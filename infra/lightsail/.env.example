# Copie para .env no servidor. Nunca vai para o Git.

POSTGRES_PASSWORD=
SIXLABORS_LICENSE_KEY=

JWT__SecretKey=
JWT__Issuer=NoiseVault

Cors__AllowedOrigins__0=https://noisevault.net
Cors__AllowedOrigins__1=https://ensaio.noisevault.net

Frontend__BaseUrl=https://noisevault.net
Auth__RefreshCookie__Domain=.noisevault.net

Storage__Bucket=noisevault-media
Storage__Region=sa-east-1
Storage__PublicBaseUrl=https://media.noisevault.net
Storage__AccessKey=
Storage__SecretKey=

Video__Engine=MediaConvert
MediaConvert__RoleArn=

Email__Provider=Smtp
Email__From__Address=nao-responda@noisevault.net
Email__From__Name=Noise Vault
Email__VerificationInbox=
Email__Smtp__Host=email-smtp.sa-east-1.amazonaws.com
Email__Smtp__Port=587
Email__Smtp__UseStartTls=true
Email__Smtp__Username=
Email__Smtp__Password=

Spotify__ClientId=
Spotify__ClientSecret=
Spotify__Market=BR

App__TimeZone=America/Sao_Paulo
Logging__ApplicationLog__Format=Text
