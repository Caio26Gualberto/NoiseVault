    "Provider": "Postgres",
    "MigrateOnStartup": true
  },
  "JWT": {
    "SecretKey": "dev-only-secret-key-change-me-please-32-chars-min",
    "Issuer": "Headbanger"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Seed": {
    "AdminPassword": "12341234"
  },
